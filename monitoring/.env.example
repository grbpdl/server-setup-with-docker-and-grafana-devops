# Grafana Configuration
GRAFANA_ROOT_URL=https://yourgrafanadomain
GRAFANA_HOSTNAME=yourgrafanadomain
# Internal Grafana container port (Traefik targets this; default is 3000)
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Grafana SMTP (alert emails)
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=your-smtp-user
GF_SMTP_PASSWORD=your-smtp-password
GF_SMTP_FROM_ADDRESS=alerts@yourdomain.com
GF_SMTP_FROM_NAME=Grafana Alerts
GF_SMTP_SKIP_VERIFY=false
# Possible values: OpportunisticStartTLS, MandatoryStartTLS, NoStartTLS
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS
# Comma-separated recipients for provisioned alert emails
GRAFANA_ALERT_EMAIL_TO=ops@yourdomain.com

# Network Configuration
NETWORK_NAME=production_network
