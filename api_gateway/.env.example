# Your email for Let's Encrypt certificate registration
ACME_EMAIL=your@email.com

# DigitalOcean API Token (replace with your actual DO token)
DO_API_TOKEN=dop_v1_your_token

# Domain and image settings
HOST_NAME=gateway.yourdomain
TRAEFIK_IMAGE=traefik:latest

# Traefik dashboard basic auth (username:htpasswd-hash)
# Generate with: htpasswd -nb admin 'your-password'
# Escape each $ as $$ so docker-compose does not treat it as a variable.
# Example: TRAEFIK_BASIC_AUTH=admin:$$apr1$$H6uskkkW$$IgXLP6ewJxNFJFpeYBVeX1
TRAEFIK_BASIC_AUTH=admin:$$apr1$$examplehashreplacewithyourownhash
