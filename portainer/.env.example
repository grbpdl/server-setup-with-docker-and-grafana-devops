PORTAINER_DOMAIN=yourdomain
PORTAINER_IMAGE=portainer/portainer-ce:latest

# Initial admin username is always "admin"
# Password must be a bcrypt hash (not plain text). Generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' | cut -d: -f2
# Escape each $ as $$ so docker-compose does not treat it as a variable.
# Example for password "changeme":
PORTAINER_ADMIN_PASSWORD=$$2y$$05$$examplehashreplacewithyourownhash
